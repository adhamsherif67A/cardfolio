{
  "expo": {
    "name": "CardFolio",
    "slug": "cardfolio",
    "version": "0.1.0",
    "orientation": "portrait",
    "platforms": [
      "ios",
      "android"
    ],
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.adhamsherif67a.cardfolio",
      "infoPlist": {
        "NSCameraUsageDescription": "Allow CardFolio to scan business cards."
      }
    },
    "android": {
      "package": "com.adhamsherif67a.cardfolio",
      "allowBackup": false
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow CardFolio to import business card photos.",
          "cameraPermission": "Allow CardFolio to photograph business cards.",
          "microphonePermission": false
        }
      ]
    ]
  }
}
